# Copy to .env and edit. Everything here has a working default except MRR_BASE_URL,
# which your forge must be able to reach.

# Public URL of this mrr instance. Used to print the webhook URL when you register
# a project. Set it to whatever the forge can resolve. Admins can also change this
# live on /configure — New Project previews {MRR_BASE_URL}/webhooks/<forge>/<project-id>.
MRR_BASE_URL=http://localhost:8130

# Host port to publish on.
MRR_PORT=8130

# Concurrent reviews. SQLite takes a write lock per connection, so keep this modest.
MRR_REVIEW_WORKERS=2

# Database. Unset means SQLite at MRR_DB_PATH (/data/mrr.db) — the default, and all a
# single-box deployment needs. Point MRR_DB_URL at an external Postgres to use one
# instead; MRR_DB_PATH is then ignored. Create the database and the user yourself, mrr
# creates its tables on first boot. There is no migration between the two backends:
# an empty Postgres gives you an empty instance, not a copy of the SQLite one.
#
# Postgres does not make mrr stateless. Memory is markdown under MRR_MEMORY_ROOT and the
# database only indexes it, so a second instance needs /data shared too — and reviews are
# still single-flight per process. See "Database" in the README.
# MRR_DB_URL=jdbc:postgresql://db:5432/mrr
# MRR_DB_USER=mrr
# MRR_DB_PASSWORD=
# Connection pool. 4 is sized for SQLite's per-connection write lock; raise it on Postgres.
# MRR_DB_POOL_SIZE=10

# Catch-up against the forge for missed commits and merged/closed requests.
MRR_SCAN_INTERVAL_MS=120000

# Diffs longer than this are reviewed in slices rather than silently chopped.
MRR_MAX_DIFF_CHARS=200000
MRR_MAX_DIFF_CHUNKS=8

# Tool results stored on reviews.trace / replies.trace are capped at this many characters.
# The model still sees the full file. DEBUG logs still print the full body.
MRR_MAX_TRACE_CHARS=8000

# Model output budget (Anthropic max_tokens / OpenAI max_tokens).
MRR_MAX_MODEL_TOKENS=16000
MRR_ANTHROPIC_EFFORT=high

# Note: there are no API keys here. Forge tokens and LLM keys are per-project and
# are supplied when you register a project via POST /api/projects.

# Encrypts those per-project credentials at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Unset means they are stored in plaintext and mrr warns on every boot.
#
# There is no migration either direction: setting, changing, or losing this key means
# re-entering every project's forge token and model key. Back it up, and keep it
# somewhere other than the /data volume it protects.
# MRR_SECRET_KEY=

# Same thing read from a file, which keeps the key out of `docker inspect` and the
# process environment. Point it outside /data. Set this or MRR_SECRET_KEY, never
# both — mrr refuses to start rather than guess which one sealed the database.
# MRR_SECRET_KEY_FILE=/run/secrets/mrr-secret-key

# Host directory mounted at /data in Compose (SQLite, root token, memory files).
# On the VM set this to a path that survives image updates, then scp the local
# data/mrr.db, data/root-token.txt, and data/memory/ into it (uid 10001).
# Fresh ./data is often root:root; the image entrypoint chowns it unless you
# start as --user 10001, in which case: mkdir -p data && sudo chown -R 10001:10001 data
# MRR_DATA=./data
