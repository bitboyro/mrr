<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>ro.bitboy</groupId>
    <artifactId>mrr</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <name>mrr</name>
    <description>AI code review for GitLab merge requests</description>

    <!--
      Deliberately dependency-light: web, jdbc, sqlite, actuator, the MCP starter, springdoc,
      and the Anthropic SDK. No Spring Security (one TokenFilter), no JPA (JdbcClient +
      schema.sql), no WebFlux (RestClient). mrr must build for someone who has never heard of
      the bitboy platform, so it resolves from Maven Central only.

      Actuator earns its place for /health: the endpoint is remapped to the bare path the
      container healthcheck and start-instance.sh already call, DataSource probing is off so it
      stays a pure liveness check, and only `health` is exposed. That is a starter for one
      endpoint, but it is the starter the Spring ecosystem points at, and the hand-rolled
      controller it replaces was drifting toward re-implementing it.

      anthropic-java is the one dependency past the original five-dep budget. Hand-rolling
      the Messages API wire format is a maintenance liability on a surface that moves — the
      official SDK owns retries, error typing, and the request shape. The OpenAI-compatible
      adapter stays on RestClient, since it isn't calling Claude at all.

      The Postgres driver is runtime-scoped and costs nothing until MRR_DB_URL names one:
      no code imports it, and Spring Boot picks a driver from the URL scheme. SQLite stays
      the default and the only backend a single-box deployment needs.

      JGit and tree-sitter are the next exception, and they are one decision rather than two:
      reading a repository at a commit is what the repo-intelligence tools *are*, and both
      alternatives were worse. Shelling out to `git` means a binary in the runtime image, a
      subprocess per call, and parsing porcelain. A language server means running the
      customer's build, which is a trust boundary mrr does not want to cross. JGit is pure
      Java and in-process, and its core pulls only JavaEWAH, slf4j and commons-codec. The ssh
      and gpg modules are deliberately absent: mrr clones over HTTPS with the same token it
      already uses for the API, and never verifies a signature.

      tree-sitter is JNI with prebuilt natives for the two architectures mrr ships on, and it
      is the only way to answer "which function is this line in" without a compiler. One
      artifact per grammar, tracking the bundled reviewer skills — Java, TypeScript,
      JavaScript, Python, Rust. The jar grows by roughly the size of those natives, and that
      is the price of the tools. Everything else above is unchanged: still no Security, still
      no JPA, still no WebFlux, still Maven Central only, still no `git` in the image.
    -->
    <properties>
        <java.version>21</java.version>
        <revision>0.1.0-SNAPSHOT</revision>
        <spring-ai.version>1.1.6</spring-ai.version>
        <anthropic.version>2.34.0</anthropic.version>
        <sqlite.version>3.46.1.3</sqlite.version>
        <springdoc.version>2.8.5</springdoc.version>
        <jgit.version>7.7.1.202607240634-r</jgit.version>
        <tree-sitter.version>0.26.6</tree-sitter.version>
        <ts-java.version>0.23.5</ts-java.version>
        <ts-typescript.version>0.23.2</ts-typescript.version>
        <ts-javascript.version>0.25.0</ts-javascript.version>
        <ts-python.version>0.25.0</ts-python.version>
        <ts-rust.version>0.24.0</ts-rust.version>
        <exec-plugin.version>3.5.0</exec-plugin.version>
        <!--
          docs/openapi.json is exported from a live instance during `mvn verify`: the spec
          springdoc serves is the only one that reflects the running app, so there is nothing
          to keep in sync by hand. scripts/generate-openapi.sh owns that instance start to
          finish, because a Maven phase that fails aborts the lifecycle and would strand a
          server started by the plugin. The port is the build's own, away from 8130/8131
          where a real instance may be sitting. -Dopenapi.skip=true opts out.
        -->
        <openapi.port>8137</openapi.port>
        <openapi.skip>false</openapi.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!--
          The repository layer. HTTPS transport only; org.eclipse.jgit.ssh.* and the gpg
          module are not declared, so neither Apache MINA nor BouncyCastle is on the path.
        -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <!--
          The AST layer. The core binding plus one grammar per language mrr ships a reviewer
          skill for. Each grammar artifact carries its own prebuilt natives for
          x86_64/aarch64 linux and macOS; there is nothing to build and nothing to install.
        -->
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter</artifactId>
            <version>${tree-sitter.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-java</artifactId>
            <version>${ts-java.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-typescript</artifactId>
            <version>${ts-typescript.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-javascript</artifactId>
            <version>${ts-javascript.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-python</artifactId>
            <version>${ts-python.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonede</groupId>
            <artifactId>tree-sitter-rust</artifactId>
            <version>${ts-rust.version}</version>
        </dependency>

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-plugin.version}</version>
                <executions>
                    <execution>
                        <id>export-openapi</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${openapi.skip}</skip>
                            <executable>${project.basedir}/scripts/generate-openapi.sh</executable>
                            <environmentVariables>
                                <OPENAPI_PORT>${openapi.port}</OPENAPI_PORT>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
